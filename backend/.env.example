# 应用
APP_NAME=agri-coop-trace-inventory
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_DIR=storage/logs
LOG_BACKUP_COUNT=30
TIMEZONE=Asia/Shanghai
DOCS_ENABLED=true

# PostgreSQL：也可以只配置 DATABASE_URL
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agri_trace
POSTGRES_USER=postgres
# 仅在本地 .env 中填写，不要提交真实密码
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# Redis 与 Celery
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agri_trace:
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=60
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_RESULT_EXPIRES_SECONDS=86400
ALERT_SCAN_INTERVAL_MINUTES=5

# JWT、刷新会话与 Cookie
# 生产环境必须替换为高强度随机值
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=agri-coop-trace-api
JWT_AUDIENCE=agri-coop-trace-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_DOMAIN=

# Web/API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 微信等手机设备扫描二维码时，改为本机局域网地址，例如：
# PUBLIC_TRACE_URL=http://192.168.1.100:5173/trace
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSE_HEADERS=X-Request-ID,Retry-After
TRUSTED_HOSTS=
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
IDEMPOTENCY_RETENTION_DAYS=7

# 缓存与限流
TRACE_CACHE_TTL_SECONDS=600
PUBLIC_TRACE_URL=http://localhost:5173/trace
DASHBOARD_CACHE_TTL_SECONDS=300
PERMISSION_CACHE_TTL_SECONDS=300
REFERENCE_CACHE_TTL_SECONDS=900
FORECASTING_CACHE_TTL_SECONDS=600
DETAIL_CACHE_TTL_SECONDS=180
QUERY_CACHE_ENABLED=true
CACHE_REFRESH_THRESHOLD_SECONDS=30
CACHE_TTL_JITTER_RATIO=0.1
LOGIN_RATE_LIMIT_PER_MINUTE=10
PUBLIC_TRACE_RATE_LIMIT_PER_MINUTE=60
PUBLIC_QR_RATE_LIMIT_PER_MINUTE=120
AI_TASK_RATE_LIMIT_PER_MINUTE=5

# 文件存储
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/png,image/jpeg
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# AI 与演示数据
MODEL_ARTIFACT_DIR=storage/models
ML_DEFAULT_MODEL_TYPE=XGBOOST
ML_RANDOM_SEED=20260904
ML_ALLOWED_HORIZONS_DAYS=7,30
# 演示账号密码仅写入本地 .env，不提交到 Git
DEMO_PASSWORD=
DEMO_DATA_SEED=20260904
